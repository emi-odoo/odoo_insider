<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_brand_view_form" model="ir.ui.view">
        <field name="name">product.brand.view.form</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Close brand if old"  name="move_close_if_old_enough" type="object" class="btn-primary" />
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="state == 'closed'" invisible="state == 'active'"/>
                            <field name="description" />
                            <field name="state" />
                            <field name="company_id" />
                        </group>
                        <group/>
                        <group>
                            <field name="owner_id"/>
                            <field name="salesperson_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="date" />
                            <field name="partner_ids">
                                <list>
                                    <field name="name"/>
                                </list>
                                <form>
                                    <field name="name"/>
                                </form>
                            </field>
                            <field name="partner_ids" widget="many2many_tags" />
                        </group>
                    </group>
                    <notebook>
                        <page name="description_tab" string="This is my personal string">
                            <field name="description" />
                        </page>
                        <page name="date_tab" string="Date">
                            <group>
                                <group>
                                    <field name="date" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="product_brand_view_tree" model="ir.ui.view">
        <field name="name">product.brand.view.tree</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <list string="">
                <field name="name" />
                <field name="description" />
                <field name="owner_id"/>
            </list>
        </field>
    </record>

    <record id="product_brand_view_search" model="ir.ui.view">
        <field name="name">product.brand.view.search</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="state" />
                <filter string="Partner is Ferrari or Italian" name="partner_ferrari"
                    domain="[('partner_ids', 'any', ['|',('name', 'ilike', 'Ferrari'), ('country_id.code', '=', 'IT')])]" />
                <group>
                    <filter name="owner" string="Owner" context="{'group_by': 'partner_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="product_brand_action" model="ir.actions.act_window">
        <field name="name">Product Brand</field>
        <field name="res_model">product.brand</field>
        <field name="view_mode">list,form,kanban,pivot</field>
        <field name="domain">[

            ]</field>
        <field name="context">{
            'default_name': 'Ferrari',
            }</field>
    </record>

    <record id="product_brand_action_2" model="ir.actions.act_window">
        <field name="name">Product Brand</field>
        <field name="res_model">product.brand</field>
        <field name="view_mode">list,form,kanban,pivot</field>
        <field name="domain">[

            ]</field>
        <field name="context">{
            'default_name': 'Ferrari',
            }</field>
    </record>

    <record id="product_brand_view_tree_inherit_product_brand" model="ir.ui.view">
        <field name="name">produce.brand.view.form.inherit</field>
        <field name="model">product.brand</field>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="product_brand.product_brand_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description']" position="after">
                <field name="salesperson_id"/>
            </xpath>
        </field>
    </record>

    <record id="product_brand_view_tree_inherit_product_brand_2" model="ir.ui.view">
        <field name="name">produce.brand.view.form.inherit</field>
        <field name="model">product.brand</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="product_brand.product_brand_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description']" position="after">
                <field name="other_salesperson_id"/>
            </xpath>
        </field>
    </record>

    <menuitem
        id="product_brand_menu"
        name="Product Brands"
        action="product_brand_action"
        parent="sale.prod_config_main"
        sequence="100" />

    <menuitem
        id="product_brand_menu_2"
        name="Product Brands Other view"
        action="product_brand_action_2"
        parent="sale.prod_config_main"
        sequence="100" />
</odoo>


